# DarkFleet API — the single analytical authority (FastAPI + Rasterio/GDAL).
# Non-root, no capabilities, no stray mounts.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# rasterio ships self-contained wheels (verified: rasterio 1.5.2 / GDAL 3.12.2
# with no system GDAL present), so no versioned geo packages are installed here.
# Pinning libgdal32/libgeos-c1v5/libproj25 was the wrong call: `python:3.12-slim`
# moved from bookworm to trixie and those names no longer resolve, which broke
# the build outright. The one library the wheel genuinely needs from the OS is
# libexpat.so.1. `curl` backs the healthcheck below.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libexpat1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY backend/darkfleet /app/backend/darkfleet

RUN pip install --no-cache-dir /app/backend

# Unprivileged runtime user; the data volume is chowned to it.
RUN useradd --create-home --uid 10001 darkfleet \
    && mkdir -p /data/ais /data/cache /data/scans /data/boundaries \
    && chown -R darkfleet:darkfleet /data /app
USER darkfleet

ENV DARKFLEET_DATA_DIR=/data \
    DARKFLEET_API_HOST=0.0.0.0 \
    DARKFLEET_API_PORT=8000

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8000/api/providers/health" || exit 1

CMD ["uvicorn", "darkfleet.api.app:app", "--host", "0.0.0.0", "--port", "8000"]