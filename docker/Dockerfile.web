# DarkFleet web — static Vite build served by nginx.
# The browser bundle contains NO provider credentials and no analytics logic.

FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .
RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Cesium's static assets are served from /cesium by vite-plugin-cesium.
COPY --from=build /app/dist /usr/share/nginx/html

# API requests are proxied so the browser never needs a second origin.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]