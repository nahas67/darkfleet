# GEMINI_API_KEY: Optional. Enables AI evidence debrief only. Never required for detection.
GEMINI_API_KEY=""

# APP_URL: Public URL of this deployment (self-referential links, callbacks).
APP_URL="http://localhost:3000"

# ---- DarkFleet runtime ----
# Every scan is a REAL scan against a live provider. There is no synthetic
# runtime mode: this tool will not fabricate an observation for you.
DARKFLEET_RUNTIME_MODE="REAL"
DARKFLEET_DATA_DIR="data"

# Synthetic scenes exist ONLY for the automated test suite, which needs a raster
# without provider credentials or network. It is off here and must stay off in
# any deployment: with it on, the API will serve fabricated observations.
# DARKFLEET_ALLOW_SYNTHETIC_SCENES="false"

# ---- REAL SAR providers (capability-based; configure what you have) ----
# DARKFLEET_PC_STAC_URL="https://planetarycomputer.microsoft.com/api/stac/v1"
# DARKFLEET_CDSE_CLIENT_ID=""
# DARKFLEET_CDSE_CLIENT_SECRET=""
# DARKFLEET_EARTHSEARCH_STAC_URL="https://earth-search.aws.element84.com/v1"

# ---- REAL AIS providers (at least one historical-capable source needed for
# retrospective overpass correlation) ----
# DARKFLEET_AIS__AISTREAM_API_KEY=""
# DARKFLEET_AIS__AISHUB_USERNAME=""
# DARKFLEET_AIS__GFW_API_TOKEN=""
